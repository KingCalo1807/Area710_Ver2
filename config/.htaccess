# Blockiere direkten Zugriff auf alle Dateien in diesem Ordner
# Schützt sensible Konfigurationsdateien (SMTP-Credentials etc.)

# Alle Dateien im Ordner blockieren
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
